# Realtime Database rules (example)

{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.token.role == 'ntei' || auth.token.prontuario == $uid)",
        ".write": "auth != null && auth.token.role == 'ntei'"
      }
    },
    "editais": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.role == 'ntei'"
    },
    "audit": {
      ".read": "auth != null && auth.token.role == 'ntei'",
      ".write": "auth != null"
    }
  }
}
